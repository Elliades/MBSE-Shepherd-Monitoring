      "FlightPlan",
      "Start Sheep Guard Mission",
      "FlightPlan Correct",
      "FlightPlan Incorrect"
     ],
     "out": []
    },
    {
     "name": "verdict",
     "out": [
      "Ready for mission_ext",
      "FlightPlan Check Failed_ext"
     ],
     "in": []
    },
    {
     "name": "orch",
