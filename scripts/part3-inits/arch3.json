       },
       {
        "name": "Ready for Mission",
        "do": "Start subsystems"
       }
      ],
      "transitions": [
       {
        "from": "Off",
        "to": "Unconfigured",
        "on": "Start SOI"
       },
       {
        "from": "Unconfigured",
        "to": "Configured",
        "on": [
         "FlightPlan Correct",
         "FlightPlan Incorrect"
        ]
       },
       {
        "from": "Configured",
        "to": "Ready for Mission",
        "on": "Ready for mission",
        "delegate": "verdict"
       },
       {
        "from": "Configured",
        "to": "Unconfigured",
        "on": "FlightPlan Check Failed",
        "delegate": "verdict"
