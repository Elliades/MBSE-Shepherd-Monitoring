    "date": "2026-11-04",
    "tags": [
      "part3",
      "architecture 1"
    ],
    "sequence": [
      "arch1.power-on",
      "arch1.plan-rejected",
      "arch1.plan-accepted",
      "arch1.mission-start",
      "arch1.sheep-out",
      "arch1.bear-enters",
      "arch1.bear-deterred",
      "arch1.bear-gone"
    ]
  }
}
