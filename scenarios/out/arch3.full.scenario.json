      "type": "Mission Configuration"
    },
    {
      "path": "soi.bsrc",
      "label": "Base station link",
      "type": "Base station remote communication"
    },
    {
      "path": "soi.orch",
      "label": "Mission Orchestrator",
      "type": "Mission Orchestrator"
    },
    {
      "path": "soi.ap",
      "label": "AutoPilot",
      "type": "AutoPilot"
    },
    {
      "path": "soi.zp",
      "label": "Zone Patrolling",
      "type": "Zone Patrolling"
    },
    {
      "path": "soi.sm",
      "label": "SheepMonitoring",
      "type": "SheepMonitoring"
    },
    {
      "path": "soi.pm",
      "label": "Predator Management",
      "type": "Predator Management"
    },
    {
      "path": "soi.trk",
      "label": "Tracking",
      "type": "Tracking"
    }
  ],
  "drivers": [
    {
      "path": "operator",
      "label": "Operator",
      "type": "Operator"
    },
    {
      "path": "pasture",
      "label": "Pasture Environment",
      "type": "Pasture Environment"
    }
  ],
  "phases": [
    {
      "name": "Preparation",
      "goal": "",
      "steps": [
        {
          "id": "power",
          "signal": "Start SOI",
          "into": "operator",
          "note": "The operator powers the drone on.",
          "expect": {
            "soi.mi": [
              "Powered On"
            ],
            "soi.mc": [
              "Unconfigured"
            ]
          }
        },
        {
          "id": "bad-plan",
          "signal": "FlightPlan Incorrect",
          "into": "operator",
          "note": "A wrong plan: Load Flight Plan refuses it, Mission Configuration goes back to Unconfigured and the operator is told.",
          "expect": {
            "soi.mc": [
              "Unconfigured"
            ]
          },
          "messages": [
            "FlightPlan Check Failed"
          ]
        },
        {
          "id": "good-plan",
          "signal": "FlightPlan Correct",
          "into": "operator",
          "note": "The flight plan is loaded and checked.",
          "expect": {
            "soi.mc": [
              "Ready for Mission"
            ]
          },
          "messages": [
            "Ready for mission"
          ]
        }
      ],
      "source": [
        "arch3.power-on",
        "arch3.plan-rejected",
        "arch3.plan-accepted"
      ]
    },
    {
      "name": "Guarding the flock",
      "goal": "",
      "steps": [
        {
          "id": "start",
          "signal": "Start Sheep Guard Mission",
          "into": "operator",
          "note": "Launch: safe area, then patrol.",
          "expect": {
            "soi.mc": [
              "Deployed"
            ],
            "soi.orch": [
              "Patrolling",
              "Dispatching"
            ],
            "soi.ap": [
              "Following Watch Path"
            ],
            "soi.zp": [
              "Perimeter watch"
            ],
            "soi.sm": [
              "Sheep Monitoring"
            ],
            "soi.pm": [
              "Monitoring predators"
            ],
            "soi.trk": [
              "Tracking Idle"
            ]
          }
        },
        {
          "id": "flock",
          "signal": "Sheep Signature",
          "into": "pasture",
          "note": "The observation goes through the orchestrator, which dispatches it to the sheep monitoring.",
          "expect": {
            "soi.sm": [
              "Sheep Monitoring"
            ],
            "soi.orch": [
              "Patrolling"
            ]
          }
        },
        {
          "id": "sheep-out",
          "signal": "Sheep Out Of Zone",
          "into": "pasture",
          "note": "A sheep leaves the zone: report to the orchestrator, which alerts the operator.",
          "expect": {
            "soi.sm": [
              "Sheep Monitoring"
            ],
            "soi.orch": [
              "Patrolling"
            ]
          },
          "messages": [
            "Sheep Exit Alert"
          ]
        }
      ],
      "source": [
        "arch3.mission-start",
        "arch3.sheep-out"
      ]
    },
    {
      "name": "Predator response",
      "goal": "",
      "steps": [
        {
          "id": "bear",
          "signal": "Predator Detected inside tracking perimeter",
          "into": "pasture",
          "note": "Tracking request: the predator takes priority, the orchestrator dispatches the orders.",
          "expect": {
            "soi.orch": [
              "Predator tracking"
            ],
            "soi.zp": [
              "Path Standby"
            ],
            "soi.sm": [
              "Deactivated"
            ],
            "soi.trk": [
              "Tracking Target"
            ],
            "soi.ap": [
              "Following Predator"
            ]
          },
          "messages": [
            "Predator Alert"
          ]
        },
        {
          "id": "too-close",
          "signal": "Predator entering safe perimiter",
          "into": "pasture",
          "note": "Engage request: the orchestrator orders the deterrence.",
          "expect": {
            "soi.orch": [
              "Predator counteraction"
            ],
            "soi.pm": [
              "Deterring"
            ]
          },
          "messages": [
            "Light burst",
            "Sound burst"
          ]
        },
        {
          "id": "backs-off",
          "signal": "Predator leaving safe perimiter",
          "into": "pasture",
          "note": "Disengage request: back to tracking.",
          "expect": {
            "soi.orch": [
              "Predator tracking"
            ],
            "soi.pm": [
              "Deterrence idle"
            ]
          }
        },
        {
          "id": "bear-gone",
          "signal": "Predator leaving tracking perimiter",
          "into": "pasture",
          "note": "End of tracking: the orchestrator restarts patrol and guard, the path takes priority again.",
          "expect": {
            "soi.orch": [
              "Patrolling"
            ],
            "soi.zp": [
              "Perimeter watch"
            ],
            "soi.sm": [
              "Sheep Monitoring"
            ],
            "soi.trk": [
              "Tracking Idle"
            ],
            "soi.ap": [
              "Following Watch Path"
            ]
          },
          "messages": [
            "Predator Cleared"
          ]
        }
      ],
      "source": [
        "arch3.bear-enters",
        "arch3.bear-deterred",
        "arch3.bear-gone"
      ]
    }
  ],
