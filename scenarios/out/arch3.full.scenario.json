{
  "title": "The whole mission",
  "objective": "The whole story, preparation, patrol, sheep, bear, back to patrol: the scenario of the guide, assembled from its parts.",
  "context": "Logical SOI 3 - Centralized orchestrator Simulation",
  "cut": "Logical SOI 3 - Centralized orchestrator",
  "settle": 2,
  "systems": [
